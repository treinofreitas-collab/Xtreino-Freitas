rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isSelf(userId) { return isSignedIn() && request.auth.uid == userId; }

    // CEO / super-admin (via email whitelist)
    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','Admin','ADMIN','Ceo','CEO','ceo'];
    }

    // VENDEDOR
    function isVendedor() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['vendedor','Vendedor','VENDEDOR','operador','Operador','OPERADOR'];
    }

    // AFILIADO
    function isAfiliado() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['afiliado','Afiliado','AFILIADO'] ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.affiliate == true) ||
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.affiliateStatus in ['active','pending','inactive'])
      );
    }

    // STAFF / ADMIN-role / MODERADOR
    function isStaff() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in
        ['staff','Staff','STAFF','admin','Admin','ADMIN','moderador','Moderador','MODERADOR'];
    }

    // GERENTE (inclui ceo para herança)
    function isGerente() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in
        ['gerente','Gerente','GERENTE','Ceo','CEO','ceo'];
    }

    // CEO/ADMIN com email autorizado (whitelist para ações destrutivas)
    function isAuthorizedAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','Admin','ADMIN','Ceo','CEO','ceo'] &&
        request.auth.token.email in [
          'cleitondouglass@gmail.com',
          'cleitondouglass123@hotmail.com',
          'gilmariofreitas378@gmail.com',
          'gilmariofreitas387@gmail.com',
          'flavetyr@gmail.com',
          'admin@xtreino.dev',
          'admin.local@xtreino.dev'
        ];
    }

    // Admin autorizado OU designer (para conteúdo)
    function isAuthorizedAdminOrDesign() {
      return isSignedIn() && (
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','Admin','ADMIN','Ceo','CEO','ceo'] &&
         request.auth.token.email in [
           'cleitondouglass@gmail.com',
           'cleitondouglass123@hotmail.com',
           'gilmariofreitas378@gmail.com',
           'gilmariofreitas387@gmail.com',
           'flavetyr@gmail.com',
           'admin@xtreino.dev',
           'admin.local@xtreino.dev'
         ]) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['design','Design','DESIGN','Designer','DESIGNER','designer','Desgin','DESGIN','desgin']
      );
    }

    // DESIGNER
    function isDesign() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in
        ['design','Design','DESIGN','Designer','DESIGNER','designer','Desgin','DESGIN','desgin'];
    }

    // SOCIO
    function isSocio() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in
        ['socio','Socio','SOCIO','sócio','Sócio','SÓCIO','ceo','CEO','Ceo'];
    }

    // Quem pode ler tudo no painel
    function canReadAll() {
      return isAdmin() || isGerente() || isVendedor() || isDesign() || isSocio() || isStaff();
    }

    // Quem pode escrever conteúdo (highlights, news, products, events)
    function canWriteContent() {
      return isAuthorizedAdminOrDesign() || isGerente();
    }

    function isMarketModerator() { return isAdmin(); }

    function validMarketProfile(profileId) {
      return request.resource.data.keys().hasAll([
          'uid', 'nickname', 'mainRole', 'secondaryRoles', 'city', 'state',
          'experience', 'availability', 'availabilitySchedule', 'teamHistory',
          'championships', 'achievements', 'bio', 'socialLinks', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'uid', 'nickname', 'mainRole', 'secondaryRoles', 'city', 'state',
          'experience', 'availability', 'availabilitySchedule', 'teamHistory',
          'championships', 'achievements', 'bio', 'socialLinks', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.uid == profileId &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() >= 2 &&
        request.resource.data.nickname.size() <= 36 &&
        request.resource.data.mainRole in ['Rushador', 'Suporte', 'Fragger', 'Capitão', 'Coringa', 'Reserva', 'Coach', 'Analista'] &&
        request.resource.data.secondaryRoles is list &&
        request.resource.data.secondaryRoles.size() <= 8 &&
        request.resource.data.city is string &&
        request.resource.data.city.size() <= 60 &&
        request.resource.data.state is string &&
        request.resource.data.state.size() <= 40 &&
        request.resource.data.experience is string &&
        request.resource.data.experience.size() <= 70 &&
        request.resource.data.availability in ['looking', 'open', 'evaluating', 'unavailable', 'contracted'] &&
        request.resource.data.availabilitySchedule is string &&
        request.resource.data.availabilitySchedule.size() <= 100 &&
        request.resource.data.teamHistory is string &&
        request.resource.data.teamHistory.size() <= 500 &&
        request.resource.data.championships is string &&
        request.resource.data.championships.size() <= 400 &&
        request.resource.data.achievements is string &&
        request.resource.data.achievements.size() <= 400 &&
        request.resource.data.bio is string &&
        request.resource.data.bio.size() <= 700 &&
        request.resource.data.socialLinks is list &&
        request.resource.data.socialLinks.size() <= 4 &&
        request.resource.data.status in ['draft', 'published', 'paused'] &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
    }

    function validMarketVacancy(vacancyId) {
      return request.resource.data.keys().hasAll([
          'ownerUid', 'teamName', 'title', 'roles', 'level', 'state', 'slots',
          'schedule', 'requirements', 'championships', 'compensation',
          'description', 'validityDays', 'status', 'createdAt', 'updatedAt',
          'expiresAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'ownerUid', 'teamName', 'title', 'roles', 'level', 'state', 'slots',
          'schedule', 'requirements', 'championships', 'compensation',
          'description', 'validityDays', 'status', 'createdAt', 'updatedAt',
          'expiresAt'
        ]) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.teamName is string &&
        request.resource.data.teamName.size() >= 2 &&
        request.resource.data.teamName.size() <= 60 &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 3 &&
        request.resource.data.title.size() <= 70 &&
        request.resource.data.roles is list &&
        request.resource.data.roles.size() <= 8 &&
        request.resource.data.level is string &&
        request.resource.data.level.size() <= 30 &&
        request.resource.data.state is string &&
        request.resource.data.state.size() <= 40 &&
        request.resource.data.slots is int &&
        request.resource.data.slots >= 1 &&
        request.resource.data.slots <= 12 &&
        request.resource.data.schedule is string &&
        request.resource.data.schedule.size() <= 100 &&
        request.resource.data.requirements is string &&
        request.resource.data.requirements.size() <= 450 &&
        request.resource.data.championships is string &&
        request.resource.data.championships.size() <= 300 &&
        request.resource.data.compensation is string &&
        request.resource.data.compensation.size() <= 120 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 600 &&
        request.resource.data.validityDays in [14, 30, 60] &&
        request.resource.data.status in ['open', 'closed', 'filled'] &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt <= request.time + duration.value(60, 'd');
    }

    // Campos protegidos que usuários não podem auto-modificar
    function hasNoProtectedFieldChanges() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'tokens', 'role', 'affiliate', 'affiliateStatus', 'affiliateBalance',
        'affiliateCode', 'affiliateParent', 'affiliateSales', 'affiliateRef',
        'affiliateCommission', 'affiliatePaidOut'
      ]);
    }

    // users: leitura para staff; afiliados ativos podem ser lidos por qualquer usuário autenticado (necessário para calcular comissão)
    match /users/{userId} {
      allow read: if isSelf(userId) || canReadAll() ||
        (isSignedIn() && resource.data.affiliateStatus in ['active', 'pending', 'inactive']);
      allow create: if
        (isSelf(userId) && request.resource.data.tokens == 0 &&
         request.resource.data.role in ['Usuario', 'Usuário', 'usuario', 'Associado', 'Associado Treino', 'Cliente', 'cliente']) ||
        isAdmin();
      allow update: if (isSelf(userId) && hasNoProtectedFieldChanges()) ||
                       (isSelf(userId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens']) &&
                        request.resource.data.tokens < resource.data.tokens &&
                        request.resource.data.tokens >= 0) ||
                       isAdmin() || isGerente() || isVendedor();
      allow delete: if isAdmin() || isGerente();
    }

    // schedules
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || isGerente() || isStaff();
      allow delete: if isAdmin() || isGerente();
    }

    // orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || canReadAll());
      allow create: if canReadAll() || (isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.type != 'tokens_purchase' &&
        !request.resource.data.keys().hasAny(['paidWithTokens', 'tokensCredited', 'paymentId', 'paidAt', 'verifiedOnServer']));
      allow update: if canReadAll() ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['external_reference']) &&
         request.resource.data.external_reference == 'digital_' + orderId);
      allow delete: if isAdmin() || isGerente();
    }

    // registrations
    match /registrations/{registrationId} {
      allow get: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        canReadAll() ||
        (
          isStaff() && (
            ((resource.data.hour is number) && resource.data.hour >= 14 && resource.data.hour <= 18) ||
            ((resource.data.schedule is string) && resource.data.schedule.matches('.*(\\b14\\b|\\b15\\b|\\b16\\b|\\b17\\b|\\b18\\b|14h|15h|16h|17h|18h|14:00|15:00|16:00|17:00|18:00).*'))
          )
        )
      );
      allow list: if true;
      allow create: if canReadAll() || (isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        !request.resource.data.keys().hasAny(['paidWithTokens', 'tokensUsed', 'paidAt', 'paymentId', 'verifiedOnServer']));
      allow update: if canReadAll();
      allow delete: if isAdmin() || isGerente();
    }

    // digital_deliveries
    match /digital_deliveries/{deliveryId} {
      allow read: if isSignedIn() && (resource.data.customerEmail == request.auth.token.email || canReadAll());
      allow create: if isSignedIn() && request.resource.data.customerEmail == request.auth.token.email;
      allow update, delete: if canReadAll();
    }

    // Checkout snapshots, receipts and token ledgers are server-only.
    match /purchase_checkouts/{id} { allow read, write: if false; }
    match /purchase_receipts/{id} { allow read, write: if false; }
    match /token_checkouts/{id} { allow read, write: if false; }
    match /token_credits/{id} { allow read, write: if false; }

    // highlights: gerente e designer podem editar
    match /highlights/{highlightId} {
      allow read: if true;
      allow create, update, delete: if canWriteContent();
    }

    // news: gerente e designer podem editar
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if canWriteContent();
    }

    // config
    match /config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin();
    }

    // products: gerente e designer podem editar
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if canWriteContent();
    }

    // product_downloads
    match /product_downloads/{downloadId} {
      allow read: if isSignedIn() && (resource.data.customerEmail == request.auth.token.email || isAdmin() || isGerente());
      allow create: if isSignedIn() && request.resource.data.customerEmail == request.auth.token.email && request.resource.data.status == 'delivered';
      allow update, delete: if isAdmin() || isGerente();
    }

    // product_categories
    match /product_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if canWriteContent();
    }

    // product_inventory
    match /product_inventory/{inventoryId} {
      allow read: if isAdmin() || isDesign() || isGerente();
      allow create, update, delete: if canWriteContent();
    }

    // product_reviews
    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.productId is string &&
        request.resource.data.customerEmail == request.auth.token.email &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.comment.size() <= 500;
      allow update, delete: if isAdmin() || isGerente();
    }

    // product_analytics
    match /product_analytics/{analyticsId} {
      allow read: if isAdmin() || isDesign() || isGerente();
      allow create, update, delete: if canWriteContent();
    }

    // product_discounts
    match /product_discounts/{discountId} {
      allow read: if true;
      allow create: if canWriteContent() &&
        request.resource.data.code is string &&
        request.resource.data.discountType in ['percentage', 'fixed'] &&
        request.resource.data.value > 0 &&
        request.resource.data.active is bool;
      allow update, delete: if canWriteContent();
    }

    // product_audit_logs
    match /product_audit_logs/{logId} {
      allow read: if isAdmin() || isDesign() || isGerente();
      allow create, update, delete: if canWriteContent();
    }

    // product_usage_stats
    match /product_usage_stats/{statsId} {
      allow read: if isAdmin() || isDesign() || isGerente();
      allow create, update, delete: if canWriteContent();
    }

    // product_backups
    match /product_backups/{backupId} {
      allow read: if isAdmin() || isDesign() || isGerente();
      allow create, update, delete: if canWriteContent();
    }

    // adminHistory: gerente e sócio podem ler
    match /adminHistory/{historyId} {
      allow read: if isAdmin() || isGerente() || isSocio();
      allow create, update, delete: if isAuthorizedAdmin() || isGerente();
    }

    // coupons: gerente pode gerenciar cupons
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAuthorizedAdmin() || isGerente();
    }

    // couponUsage
    match /couponUsage/{usageId} {
      allow read: if isAdmin() || isGerente() || isSocio() || isAfiliado() || isVendedor();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || isGerente();
    }

    // affiliates: cadastro de afiliados
    match /affiliates/{affiliateId} {
      allow read: if canReadAll() || isAfiliado();
      allow create, update: if isAdmin() || isGerente() || isVendedor();
      allow delete: if isAdmin() || isGerente();
    }

    // affiliate_sales
    match /affiliate_sales/{saleId} {
      allow read: if isSignedIn() && (
        isAdmin() || isGerente() || isStaff() || isVendedor() ||
        (
          isAfiliado() && (
            resource.data.affiliateId == request.auth.uid ||
            resource.data.affiliateUid == request.auth.uid ||
            resource.data.affiliateEmail == request.auth.token.email
          )
        )
      );
      allow create: if isSignedIn();
      allow update: if isAdmin() || isGerente() || isStaff() || isVendedor();
      allow delete: if isAdmin() || isGerente();
    }

    // affiliate_commissions
    match /affiliate_commissions/{commissionId} {
      allow read: if isSignedIn() && (
        isAdmin() || isGerente() || isStaff() || isVendedor() ||
        (
          isAfiliado() && (
            resource.data.affiliateId == request.auth.uid ||
            resource.data.affiliateUid == request.auth.uid ||
            resource.data.affiliateEmail == request.auth.token.email
          )
        )
      );
      allow create: if isSignedIn() && (isAdmin() || isGerente() || isStaff() || isVendedor());
      allow update: if isAdmin() || isGerente() || isStaff() || isVendedor();
      allow delete: if isAdmin() || isGerente();
    }

    match /affiliate_payout_requests/{requestId} {
      allow create: if isAfiliado() && request.auth.uid == request.resource.data.affiliateId
                    && (request.resource.data.amount is number) && request.resource.data.amount >= 25
                    && (request.resource.data.status == 'pending' || request.resource.data.status == 'requested');
      allow read: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin() || isGerente());
      allow update, delete: if isAdmin() || isGerente();
    }

    // affiliate_payouts: solicitações de saque de afiliados
    match /affiliate_payouts/{payoutId} {
      allow create: if (isAfiliado() && request.auth.uid == request.resource.data.affiliateId
                    && (request.resource.data.amount is number) && request.resource.data.amount >= 25
                    && request.resource.data.status == 'pending')
                    || isAdmin() || isGerente();
      allow get: if isSignedIn() && (resource.data.affiliateId == request.auth.uid || isAdmin() || isGerente() || isVendedor());
      allow list: if isSignedIn() && (isAfiliado() || isAdmin() || isGerente() || isVendedor());
      allow update, delete: if isAdmin() || isGerente();
    }

    // whatsapp_links
    match /whatsapp_links/{linkId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAuthorizedAdminOrDesign() || isGerente();
    }

    // schedule_overrides — admin pode liberar/travar horários sem exigir whitelist de email
    match /schedule_overrides/{overrideId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isGerente() || isDesign();
    }

    // Coleções legadas de notificações desativadas; os documentos antigos permanecem armazenados.
    match /notifications/{notifId} {
      allow read, write: if false;
    }

    match /notificationReads/{readId} {
      allow read, write: if false;
    }

    // slotCounters
    match /slotCounters/{eventId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // adminEvents: gerente e designer podem criar/editar eventos
    match /adminEvents/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isGerente() || isDesign() || isStaff();
    }

    // camp_groups
    match /camp_groups/{groupId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isGerente();
    }

    // event_hour_locks
    match /event_hour_locks/{lockId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isGerente() || isStaff();
    }

    // event_global_locks
    match /event_global_locks/{lockId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isGerente() || isStaff();
    }

    // bonus_links — links de vagas bônus gerados pelo admin
    match /bonus_links/{linkId} {
      // Leitura pública: qualquer pessoa com o link pode ver os dados do evento
      allow read: if true;
      // Criação e exclusão: apenas admin/gerente
      allow create: if isAdmin() || isGerente();
      allow delete: if isAdmin() || isGerente();
      // Atualização: admin/gerente podem tudo;
      // usuário autenticado pode apenas tocar usedCount, status e claimedBy (ao resgatar vaga)
      allow update: if isAdmin() || isGerente() ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'status', 'claimedBy']));
    }

    // teams — sistema de times para treino gratuito
    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && request.auth.uid == resource.data.capitaoId;
    }

    // championship_results — resultados de semifinais e final do campeonato semanal
    match /championship_results/{resultId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isGerente() || isStaff();
    }

    // championship_config — tabela LBFF e banner do campeonato semanal
    match /championship_config/{configId} {
      allow read: if true;
      allow create, update, delete: if isAuthorizedAdmin() || isGerente();
    }

    // Mercado da Bala: perfis públicos contêm apenas dados escolhidos pelo jogador.
    match /market_profiles/{profileId} {
      allow get, list: if resource.data.status == 'published' ||
        (isSignedIn() && request.auth.uid == profileId) || isMarketModerator();
      allow create: if isSignedIn() && request.auth.uid == profileId &&
        validMarketProfile(profileId) && request.resource.data.status == 'draft';
      allow update: if isMarketModerator() ||
        (isSignedIn() && request.auth.uid == profileId &&
         resource.data.status != 'suspended' &&
         validMarketProfile(profileId) &&
         request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isMarketModerator() ||
        (isSignedIn() && request.auth.uid == profileId && resource.data.status != 'suspended');
    }

    // Vagas abertas são públicas; rascunhos e demais estados ficam com o dono/admin.
    match /market_vacancies/{vacancyId} {
      allow get, list: if resource.data.status == 'open' ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isMarketModerator();
      allow create: if isSignedIn() && validMarketVacancy(vacancyId) &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isMarketModerator() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid &&
         resource.data.status != 'suspended' &&
         validMarketVacancy(vacancyId) &&
         request.resource.data.ownerUid == resource.data.ownerUid &&
         request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isMarketModerator() ||
        (isSignedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Candidaturas: só o candidato e o responsável pela vaga podem consultá-las.
    match /market_applications/{applicationId} {
      allow get, list: if isSignedIn() &&
        (resource.data.applicantUid == request.auth.uid ||
         resource.data.vacancyOwnerUid == request.auth.uid) || isMarketModerator();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'vacancyId', 'vacancyOwnerUid', 'vacancyTitle', 'teamName',
          'applicantUid', 'nickname', 'mainRole', 'message', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.applicantUid == request.auth.uid &&
        request.resource.data.vacancyId is string &&
        request.resource.data.vacancyOwnerUid is string &&
        request.resource.data.vacancyOwnerUid != request.auth.uid &&
        request.resource.data.vacancyTitle is string &&
        request.resource.data.vacancyTitle.size() <= 70 &&
        request.resource.data.teamName is string &&
        request.resource.data.teamName.size() <= 60 &&
        request.resource.data.nickname is string &&
        request.resource.data.nickname.size() <= 36 &&
        request.resource.data.mainRole in ['Rushador', 'Suporte', 'Fragger', 'Capitão', 'Coringa', 'Reserva', 'Coach', 'Analista'] &&
        request.resource.data.message is string &&
        request.resource.data.message.size() >= 5 &&
        request.resource.data.message.size() <= 600 &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        applicationId == request.resource.data.vacancyId + '__' + request.auth.uid &&
        exists(/databases/$(database)/documents/market_vacancies/$(request.resource.data.vacancyId)) &&
        get(/databases/$(database)/documents/market_vacancies/$(request.resource.data.vacancyId)).data.ownerUid == request.resource.data.vacancyOwnerUid &&
        get(/databases/$(database)/documents/market_vacancies/$(request.resource.data.vacancyId)).data.status == 'open' &&
        get(/databases/$(database)/documents/market_vacancies/$(request.resource.data.vacancyId)).data.expiresAt > request.time &&
        exists(/databases/$(database)/documents/market_profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/market_profiles/$(request.auth.uid)).data.status == 'published';
      allow update: if isMarketModerator() ||
        (isSignedIn() && resource.data.vacancyOwnerUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         request.resource.data.status in ['reviewing', 'trial_scheduled', 'approved', 'rejected'] &&
         request.resource.data.updatedAt == request.time) ||
        (isSignedIn() && resource.data.applicantUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']) &&
         request.resource.data.status == 'withdrawn' &&
         request.resource.data.updatedAt == request.time);
      allow delete: if isMarketModerator() ||
        (isSignedIn() && resource.data.applicantUid == request.auth.uid &&
         resource.data.status == 'new');
    }

    // Favoritos privados, particionados pelo proprietário.
    match /market_favorites/{favoriteId} {
      allow get, list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['ownerUid', 'profileUid', 'createdAt']) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.profileUid is string &&
        favoriteId == request.auth.uid + '__' + request.resource.data.profileUid &&
        request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/market_profiles/$(request.resource.data.profileUid)) &&
        get(/databases/$(database)/documents/market_profiles/$(request.resource.data.profileUid)).data.status == 'published';
      allow update: if isSignedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.keys().hasOnly(['ownerUid', 'profileUid', 'createdAt']) &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.profileUid == resource.data.profileUid &&
        favoriteId == request.auth.uid + '__' + request.resource.data.profileUid &&
        request.resource.data.createdAt is timestamp &&
        exists(/databases/$(database)/documents/market_profiles/$(request.resource.data.profileUid)) &&
        get(/databases/$(database)/documents/market_profiles/$(request.resource.data.profileUid)).data.status == 'published';
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // Denúncias e trilha de auditoria administrativa.
    match /market_reports/{reportId} {
      allow get, list: if isMarketModerator();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'reporterUid', 'kind', 'targetId', 'targetName', 'reason', 'status', 'createdAt'
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.kind in ['profile', 'vacancy'] &&
        request.resource.data.targetId is string &&
        request.resource.data.targetName is string &&
        request.resource.data.targetName.size() <= 80 &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 8 &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time &&
        reportId == request.auth.uid + '__' + request.resource.data.kind + '__' + request.resource.data.targetId &&
        ((request.resource.data.kind == 'profile' &&
          exists(/databases/$(database)/documents/market_profiles/$(request.resource.data.targetId)) &&
          get(/databases/$(database)/documents/market_profiles/$(request.resource.data.targetId)).data.status == 'published' &&
          get(/databases/$(database)/documents/market_profiles/$(request.resource.data.targetId)).data.uid != request.auth.uid) ||
         (request.resource.data.kind == 'vacancy' &&
          exists(/databases/$(database)/documents/market_vacancies/$(request.resource.data.targetId)) &&
          get(/databases/$(database)/documents/market_vacancies/$(request.resource.data.targetId)).data.status == 'open' &&
          get(/databases/$(database)/documents/market_vacancies/$(request.resource.data.targetId)).data.expiresAt > request.time &&
          get(/databases/$(database)/documents/market_vacancies/$(request.resource.data.targetId)).data.ownerUid != request.auth.uid));
      allow update: if isMarketModerator() && resource.data.status == 'open' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'decision', 'decisionReason', 'moderatorUid', 'reviewedAt'
        ]) &&
        request.resource.data.status == 'resolved' &&
        request.resource.data.decision in ['approved', 'removed'] &&
        request.resource.data.decisionReason is string &&
        request.resource.data.decisionReason.size() <= 500 &&
        request.resource.data.moderatorUid == request.auth.uid &&
        request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }

    match /market_audit_logs/{logId} {
      allow get, list: if isMarketModerator();
      allow create: if isMarketModerator() &&
        request.resource.data.keys().hasOnly([
          'actorUid', 'action', 'kind', 'targetId', 'reason', 'createdAt'
        ]) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.action in ['content_suspended', 'report_resolved'] &&
        request.resource.data.kind in ['profile', 'vacancy'] &&
        request.resource.data.targetId is string &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() <= 500 &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
  }
}
